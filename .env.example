# Configuración del servidor (copie este archivo como .env y ajústelo). No suba .env al repositorio.
PORT=3000
HOST=0.0.0.0
# Carpeta de la base de datos SQLite (se crea si no existe)
DATA_DIR=./data
# Carpeta con la aplicación web compilada (npm run build)
STATIC_DIR=./dist
# Administrador inicial: solo se usa si la base de datos no tiene usuarios.
# Si ADMIN_PASSWORD queda vacío, se genera una contraseña temporal que se muestra una vez en la consola.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Duración de la sesión sin actividad (horas)
SESSION_HOURS=12
# Cookie solo por HTTPS: auto (según la petición), true o false
COOKIE_SECURE=auto
# Poner a true si el servidor está detrás de un proxy inverso (nginx, IIS) que termina HTTPS
TRUST_PROXY=false
# Tamaño máximo de una importación (MB)
MAX_UPLOAD_MB=300
LOG_LEVEL=info
